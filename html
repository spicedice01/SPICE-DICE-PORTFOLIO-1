<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Spice Dice | Filmmaker · Photographer · Content Creator</title>
  <!-- Google Fonts + Font Awesome -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #0a0a1a;
      color: #fff;
      scroll-behavior: smooth;
      overflow-x: hidden;
    }

    /* colorful energetic accents */
    :root {
      --neon-pink: #ff2d75;
      --electric-yellow: #ffd700;
      --cyan-pop: #00f2fe;
      --purple-glow: #b624ff;
      --orange-blast: #ff7e05;
      --bg-dark: #0e0e1e;
    }

    /* custom scroll */
    ::-webkit-scrollbar {
      width: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #1e1e2e;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--neon-pink);
      border-radius: 20px;
    }

    /* sections */
    section {
      padding: 80px 5%;
      position: relative;
    }

    .container {
      max-width: 1300px;
      margin: 0 auto;
    }

    /* Hero video section */
    .hero {
      height: 100vh;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 5%;
      overflow: hidden;
    }
    .hero-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
      filter: brightness(0.65) saturate(1.2);
    }
    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 30% 10%, rgba(255,45,117,0.2), rgba(0,0,0,0.7));
      z-index: 1;
    }
    .hero-content {
      position: relative;
      z-index: 3;
      max-width: 900px;
    }
    .hero-content h1 {
      font-size: 5rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--neon-pink), var(--electric-yellow), var(--cyan-pop));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }
    .hero-content .tagline {
      font-size: 1.5rem;
      font-weight: 500;
      margin-bottom: 2rem;
      color: #f0f0f0;
      text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .btn-group {
      display: flex;
      gap: 1.2rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn {
      padding: 14px 32px;
      font-weight: 700;
      border-radius: 60px;
      text-decoration: none;
      transition: 0.3s ease;
      display: inline-block;
      font-size: 1rem;
    }
    .btn-primary {
      background: linear-gradient(95deg, var(--neon-pink), var(--purple-glow));
      color: white;
      box-shadow: 0 8px 20px rgba(255,45,117,0.4);
      border: none;
    }
    .btn-primary:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(255,45,117,0.6);
    }
    .btn-outline {
      border: 2px solid var(--electric-yellow);
      color: var(--electric-yellow);
      background: transparent;
    }
    .btn-outline:hover {
      background: var(--electric-yellow);
      color: #0a0a1a;
      border-color: var(--electric-yellow);
    }

    /* section titles */
    .section-title {
      font-size: 2.8rem;
      font-weight: 800;
      margin-bottom: 2rem;
      text-align: center;
      position: relative;
      display: inline-block;
      width: 100%;
    }
    .section-title span {
      background: linear-gradient(120deg, var(--neon-pink), var(--cyan-pop));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .title-decor {
      width: 80px;
      height: 4px;
      background: linear-gradient(90deg, var(--neon-pink), var(--electric-yellow));
      margin: 0.5rem auto 2rem auto;
      border-radius: 4px;
    }

    /* campaigns grid (social media campaigns & case studies) */
    .campaign-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }
    .campaign-card {
      background: rgba(20, 20, 40, 0.7);
      backdrop-filter: blur(4px);
      border-radius: 32px;
      overflow: hidden;
      transition: 0.25s ease;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 20px 35px -15px rgba(0,0,0,0.5);
    }
    .campaign-card:hover {
      transform: scale(1.02);
      border-color: var(--neon-pink);
    }
    .campaign-img {
      width: 100%;
      height: 220px;
      background: #1a1a2e;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #aaa;
      font-size: 3rem;
    }
    .campaign-img video, .campaign-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .campaign-info {
      padding: 1.5rem;
    }
    .campaign-info h3 {
      font-size: 1.6rem;
      margin-bottom: 0.6rem;
      color: var(--electric-yellow);
    }
    .campaign-info p {
      color: #ddd;
      line-height: 1.4;
    }
    .stats {
      margin-top: 1rem;
      display: flex;
      gap: 1rem;
      font-weight: 600;
      color: var(--cyan-pop);
    }

    /* YouTube channel section */
    .youtube-section {
      background: linear-gradient(145deg, #0b0b1a, #12122b);
      border-radius: 50px;
      padding: 2.5rem;
      margin-top: 1rem;
    }
    .youtube-flex {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      align-items: center;
      justify-content: space-between;
    }
    .youtube-text {
      flex: 1;
    }
    .youtube-text h3 {
      font-size: 2rem;
      color: #ff3b3b;
    }
    .yt-btn {
      background: #ff0000;
      color: white;
      padding: 12px 28px;
      border-radius: 40px;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-weight: bold;
      transition: 0.2s;
      text-decoration: none;
    }
    .yt-btn:hover {
      background: #cc0000;
      transform: scale(1.02);
    }
    .placeholder-video-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .vid-placeholder {
      background: #222;
      border-radius: 24px;
      aspect-ratio: 16/9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      color: white;
      background: #2a2a3c;
      cursor: pointer;
      transition: 0.2s;
    }
    .vid-placeholder i {
      font-size: 3rem;
      color: var(--neon-pink);
    }

    /* about & testimonials grid */
    .about-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 3rem;
      align-items: center;
    }
    .about-text {
      flex: 1.2;
    }
    .about-text p {
      font-size: 1.2rem;
      line-height: 1.6;
      margin-bottom: 1rem;
      color: #e0e0e0;
    }
    .skill-badge {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    .badge {
      background: rgba(255,45,117,0.2);
      border: 1px solid var(--neon-pink);
      padding: 6px 18px;
      border-radius: 40px;
      font-weight: 500;
    }
    .testimonial-card {
      background: rgba(25, 25, 45, 0.8);
      backdrop-filter: blur(8px);
      padding: 2rem;
      border-radius: 32px;
      border-left: 6px solid var(--electric-yellow);
      margin: 1rem 0;
    }
    .testimonial-card i {
      color: var(--electric-yellow);
      font-size: 2rem;
      margin-bottom: 1rem;
    }
    .testimonial-card p {
      font-style: italic;
    }
    .client-name {
      margin-top: 1rem;
      font-weight: 700;
      color: var(--cyan-pop);
    }

    /* contact + booking combined row */
    .contact-booking {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: space-between;
    }
    .contact-form-box, .booking-box {
      background: rgba(15, 15, 30, 0.7);
      backdrop-filter: blur(8px);
      padding: 2rem;
      border-radius: 40px;
      flex: 1;
      min-width: 260px;
      border: 1px solid rgba(255, 45, 117, 0.3);
    }
    .form-group {
      margin-bottom: 1.2rem;
    }
    input, textarea {
      width: 100%;
      padding: 14px 18px;
      background: #1e1e30;
      border: 1px solid #333;
      border-radius: 40px;
      color: white;
      font-family: inherit;
      outline: none;
    }
    input:focus, textarea:focus {
      border-color: var(--neon-pink);
    }
    button[type="submit"] {
      background: linear-gradient(95deg, var(--neon-pink), var(--purple-glow));
      border: none;
      padding: 12px 28px;
      border-radius: 40px;
      font-weight: bold;
      color: white;
      cursor: pointer;
      transition: 0.2s;
    }
    .whatsapp-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #25D366;
      padding: 12px 24px;
      border-radius: 40px;
      text-decoration: none;
      color: white;
      margin-top: 1rem;
      font-weight: 600;
    }
    .booking-box h3, .contact-form-box h3 {
      font-size: 1.8rem;
      margin-bottom: 1rem;
    }
    footer {
      text-align: center;
      padding: 2rem;
      background: #05050f;
      border-top: 1px solid #ff2d7522;
    }
    @media (max-width: 780px) {
      .hero-content h1 { font-size: 3rem; }
      .section-title { font-size: 2rem; }
      .campaign-grid { grid-template-columns: 1fr; }
      .youtube-flex { flex-direction: column; }
    }
    .nav-links {
      display: flex;
      justify-content: center;
      gap: 2rem;
      padding: 1rem;
      position: sticky;
      top: 0;
      background: #0e0e1ee0;
      backdrop-filter: blur(12px);
      z-index: 99;
      font-weight: 600;
    }
    .nav-links a {
      color: white;
      text-decoration: none;
      transition: 0.2s;
    }
    .nav-links a:hover { color: var(--neon-pink); }
  </style>
</head>
<body>

<!-- Sticky Nav -->
<div class="nav-links">
  <a href="#home">HOME</a>
  <a href="#campaigns">CAMPAIGNS</a>
  <a href="#youtube">YOUTUBE</a>
  <a href="#about">ABOUT</a>
  <a href="#testimonials">TESTIMONIALS</a>
  <a href="#contact">CONTACT</a>
</div>

<!-- Hero with video background -->
<section id="home" class="hero">
  <video class="hero-video" autoplay muted loop playsinline>
    <source src="https://cdn.pixabay.com/video/2020/10/01/50942-466590716_large.mp4" type="video/mp4">

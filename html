</section>

<!-- Contact + Booking (Client booking + contact form) -->
<section id="contact">
  <div class="container">
    <h2 class="section-title"><span>Connect</span> & Book</h2>
    <div class="title-decor"></div>
    <div class="contact-booking">
      <!-- Contact form (email + whatsapp) -->
      <div class="contact-form-box">
        <h3><i class="fas fa-envelope"></i> Send a message</h3>
        <form id="contactForm" action="#" method="post">
          <div class="form-group">
            <input type="text" placeholder="Your Name" required>
          </div>
          <div class="form-group">
            <input type="email" placeholder="Email Address" required>
          </div>
          <div class="form-group">
            <textarea rows="3" placeholder="Tell me about your project..."></textarea>
          </div>
          <button type="submit">Send via Email <i class="fas fa-paper-plane"></i></button>
        </form>
        <div style="margin-top: 1.8rem;">
          <a href="https://wa.me/1234567890?text=Hey%20Spice%20Dice%2C%20I%20want%20to%20collaborate!" class="whatsapp-link" target="_blank"><i class="fab fa-whatsapp"></i> Chat on WhatsApp</a>
          <p style="font-size:0.8rem; margin-top:0.8rem;">+1 234 567 890 (example – you can update)</p>
        </div>
      </div>
      <!-- Client Booking special section -->
      <div class="booking-box">
        <h3><i class="fas fa-calendar-alt"></i> Client Booking</h3>
        <p>Ready to spice up your project? Book a discovery call or reserve a production slot.</p>
        <div style="margin: 1.5rem 0;">
          <label style="font-weight:600;">Select service:</label>
          <select id="bookingSelect" style="width:100%; margin-top:8px; padding:12px; border-radius:40px; background:#1e1e30; color:white; border:none;">
            <option>Film production / Video ad</option>
            <option>Photoshoot (studio/outdoor)</option>
            <option>Social media management (monthly)</option>
            <option>Content creator package</option>
          </select>
        </div>
        <a href="#" class="btn btn-primary" id="mockBookingBtn" style="display: inline-block; text-align: center; width:100%;"><i class="fas fa-clock"></i> Request Booking</a>
        <p style="margin-top: 1rem; font-size:0.85rem;">📅 You'll receive a confirmation via email/WhatsApp within 24h.</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <p>© 2025 Spice Dice — Filmmaker, Photographer & Creative Director. All visuals placeholder / energetic storytelling.</p>
  <div style="margin-top: 0.6rem;">
    <i class="fab fa-instagram" style="margin:0 0.5rem; color:var(--neon-pink)"></i>
    <i class="fab fa-tiktok" style="margin:0 0.5rem; color:var(--cyan-pop)"></i>
    <i class="fab fa-youtube" style="margin:0 0.5rem; color:#ff0000"></i>
  </div>
</footer>

<script>
  // Simple contact form alert demo + booking button alert
  const contactForm = document.getElementById('contactForm');
  if(contactForm) {
    contactForm.addEventListener('submit', function(e) {
      e.preventDefault();
      alert('✨ Thanks Spice Dice fan! Your message has been sent (demo). Spice will reach out via email or WhatsApp shortly!');
      contactForm.reset();
    });
  }

  const bookingBtn = document.getElementById('mockBookingBtn');
  if(bookingBtn) {
    bookingBtn.addEventListener('click', function(e) {
      e.preventDefault();
      const selected = document.getElementById('bookingSelect')?.value || 'service';
      alert(`🔥 Booking request sent for: ${selected}. Spice Dice will contact you within 24h via WhatsApp or email. Let's create magic!`);
    });
  }

  // dummy whatsapp number alert for placeholder
  const whatsappLink = document.querySelector('.whatsapp-link');
  if(whatsappLink) {
    whatsappLink.addEventListener('click', function(e) {
      // just for demo: show note that number is placeholder - we keep original link but also let them know
      if(!confirm('This is a demo WhatsApp number. You can replace "+1234567890" with your actual number. Continue to open WhatsApp demo?')) {
        e.preventDefault();
      }
    });
  }
</script>
</body>

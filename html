    <div class="btn-group">
      <a href="#contact" class="btn btn-primary"><i class="fas fa-calendar-check"></i> Book Now</a>
      <a href="#campaigns" class="btn btn-outline"><i class="fas fa-play-circle"></i> View Work</a>

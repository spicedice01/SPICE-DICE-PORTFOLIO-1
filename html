  </div>
</section>

<!-- YouTube Channel Section -->
<section id="youtube">
  <div class="container youtube-section">
    <div class="youtube-flex">
      <div class="youtube-text">
        <h3><i class="fab fa-youtube"></i> Spice Dice YouTube</h3>
        <p style="margin: 1rem 0; font-size:1.1rem">Cinematic vlogs, tutorials, and behind the scenes of my creative productions. Subscribe for high-energy storytelling.</p>
        <a href="#" class="yt-btn" target="_blank"><i class="fab fa-youtube"></i> Subscribe on YouTube</a>
      </div>
      <div class="placeholder-video-grid">
        <div class="vid-placeholder"><i class="fas fa-play-circle"></i></div>
        <div class="vid-placeholder"><i class="fas fa-camera"></i></div>

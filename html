        <div class="vid-placeholder"><i class="fas fa-video"></i></div>
      </div>
    </div>
  </div>
</section>

<!-- About + Testimonials combo (two columns) -->
<section id="about">
  <div class="container">
    <h2 class="section-title">About <span>Spice Dice</span></h2>
    <div class="title-decor"></div>
    <div class="about-grid">
      <div class="about-text">
